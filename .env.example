# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# PostgreSQL — paste your Supabase connection string here in production
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/gogoldocs

# JWT — generate a strong random string for production
JWT_SECRET=gogoldocs_dev_secret_change_me
JWT_EXPIRES_IN=7d

# CORS — in production this will be your Vercel frontend URL
CLIENT_ORIGIN=http://localhost:5500
